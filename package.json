{
  "name": "pkc-protocol-test",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "test": "vitest run --config vitest.config.js",
    "test:watch": "vitest --config vitest.config.js",
    "test:browser": "npm run test:browser:chromium && npm run test:browser:firefox",
    "test:browser:chromium": "cross-env VITEST_BROWSER=chromium vitest --run --browser --config config/vitest.browser.config.js",
    "test:browser:firefox": "cross-env VITEST_BROWSER=firefox vitest --run --browser --config config/vitest.browser.config.js",
    "test:server": "rm -rf .pkc/ && node --es-module-specifier-resolution=node test/test-server",
    "test:server:wait-on": "wait-on http://localhost:59281 --timeout 120000",
    "prettier": "prettier {src,test,config}/**/*.{cjs,js,jsx,ts,tsx} --config config/prettier.config.js --write"
  },
  "dependencies": {
    "@noble/ed25519": "^1.7.5",
    "@pkcprotocol/pkc-js": "github:pkcprotocol/pkc-js#d7bf2e0a8fd5f26e1d4ead27bbccea0085ea5873",
    "cborg": "1.9.6",
    "eslint": "8.4.1",
    "husky": "4.3.8",
    "kubo": "0.43.1",
    "kubo-rpc-client": "^6.1.0",
    "libp2p-crypto": "^0.21.2",
    "lint-staged": "12.3.8",
    "node-forge": "^1.4.0",
    "peer-id": "^0.16.0",
    "prettier": "3.2.5",
    "tempy": "1.0.1",
    "uint8arrays": "^5.1.0",
    "wait-on": "6.0.1"
  },
  "lint-staged": {
    "{src,test,config}/**/*.{cjs,js,jsx,ts,tsx}": [
      "prettier --config config/prettier.config.js --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "devDependencies": {
    "@vitest/browser": "3.2.4",
    "cross-env": "7.0.3",
    "playwright": "1.53.1",
    "vite": "7.1.10",
    "vitest": "3.2.4"
  }
}
